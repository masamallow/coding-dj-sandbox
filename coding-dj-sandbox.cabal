cabal-version:      3.4
name:               coding-dj-sandbox
version:            0.1.0.0
synopsis:           Live-coding sandbox for TidalCycles and Haskell learning
license:            BSD-3-Clause
license-file:       LICENSE
author:             masamallow
maintainer:         77992722+masamallow@users.noreply.github.com
category:           Sound
build-type:         Simple

common warnings
    ghc-options: -Wall

-- This package exists to keep `tidal` repo-scoped (built into dist-newstyle/
-- and the shared cabal store, never the user-global GHC environment) and to
-- compile helper modules under src/ so that `cabal repl` and HLS see them.
library
    import:           warnings
    -- Register helper modules here as they are added under src/
    -- (e.g. `exposed-modules: MyHelpers`).
    exposed-modules:
    hs-source-dirs:   src
    default-language: GHC2021
    -- base >=4.18 is GHC 9.6, the oldest GHC that Tidal's CI builds with.
    -- tidal ^>=1.10 follows the PVP: 1.10 is the compatibility unit
    -- (the boot file changed between 1.9 and 1.10); bump it deliberately
    -- and diff BootTidal.hs against the new release.
    build-depends:
        base >=4.18 && <5,
        tidal ^>=1.10
