{
  "files.associations": {
    "*.tidal": "haskell",
    "BootTidal.hs": "haskell"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  // The Tidal extension spawns the REPL via /bin/sh without a working
  // directory, so point it at the wrapper that cds to the repo root and
  // launches `cabal repl`. Home-relative; adjust if the repo moves.
  "tidalcycles.ghciPath": "~/path/to/coding-dj-sandbox/boot/tidal-repl.sh",
  "[haskell]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  }
}
